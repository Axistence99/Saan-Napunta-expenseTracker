<resources>
    <!-- App-wide native theme: no ActionBar because MainActivity draws its own header. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <!-- Typography and dark system-bar treatment shared by both Activities. -->
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Background shown before the first Activity frame is ready. -->
        <item name="android:windowBackground">@drawable/splash_background</item>

        <!-- Default accent and text colors inherited by native Android controls. -->
        <item name="android:colorAccent">@color/accent_light</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>
</resources>
